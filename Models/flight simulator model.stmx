					<style>
						<isee:stacked_container item_spacing="0" corner_radius="4" selected_item_color="black" selected_item_background="white" item_background="#DDDDDD" transparent_bg="false"/>
					</style>
					<text_box z_index="-2" background="#F8F8F8" font_weight="bold" text_align="center" vertical_text_align="center" font_size="24pt" appearance="transparent" x="-1" y="-1" width="1082" height="43.6667">Management Flight Simulator - Preparedness</text_box>
					<graphics_frame fill="none" x="7.66667" y="-1" width="124" height="43.6667">
						<image width="1600" height="532" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">C:/Users/Elizabeth/OneDrive - National University of Ireland, Galway/Rapide/Rapide logo.jpg</image>
					</graphics_frame>
					<graphics_frame fill="none" x="595" y="241.667" width="100" height="100">
						<image width="0" height="0" size_to_parent="false" isee:transparency="0" isee:fixed_aspect_ratio="true"/>
					</graphics_frame>
					<isee:navigation_widget orientation="horizontal" x="263.333" y="395" width="300" height="30"/>
					<isee:shape border_width="5" x="-27.3333" y="-93.6667" width="1121.67" height="138.333" kind="rectangle"/>
				</view>
				<view isee:template_view="template:1" isee:name="Dashboard tabbed" isee:original_design="Deluxe Prev-Next Blue Green Pastel" background="white" page_width="1066" page_height="600" type="template">
					<style>
						<isee:stacked_container item_spacing="0" corner_radius="4" selected_item_color="black" selected_item_background="white" item_background="#DDDDDD" transparent_bg="false"/>
					</style>
					<button background="#284B63" font_weight="bold" font_color="#D9D9D9" font_family="Arial Rounded MT Bold" font_size="16pt" border_width="thin" border_style="none" corner_radius="8" isee:flat="false" isee:highlight_on_hover="true" isee:highlight_color="#3C6E71" label="Simulate" isee:tooltip="" x="194.294" y="547.206" width="82" height="35">
						<actions>
							<action>start</action>
						</actions>
					</button>
					<button background="#284B63" font_weight="bold" font_color="#D9D9D9" font_family="Arial Rounded MT Bold" font_size="16pt" border_width="thin" border_style="none" corner_radius="8" isee:flat="false" isee:highlight_on_hover="true" isee:highlight_color="#3C6E71" label="Pause" isee:tooltip="" x="284.294" y="547.206" width="82" height="35">
						<actions>
							<action>pause</action>
						</actions>
					</button>
					<button background="#284B63" font_weight="bold" font_color="#D9D9D9" font_family="Arial Rounded MT Bold" font_size="16pt" border_width="thin" border_style="none" corner_radius="8" isee:flat="false" isee:highlight_on_hover="true" isee:highlight_color="#3C6E71" label="Restore" isee:tooltip="" x="373.294" y="547.206" width="82" height="35">
						<actions>
							<action>restore_all</action>
						</actions>
					</button>
					<isee:time_slider z_index="5" color="#3C6E71" interactive="true" appearance="progress" x="552.064" y="545.206" width="281.578" height="39"/>
					<isee:navigation_widget font_size="16pt" border_width="thin" border_style="none" item_spacing="10" selected_item_color="#D9D9D9" selected_item_background="#3C6E71" item_background="#B4C0C8" orientation="horizontal" x="50" y="61.5851" width="430.353" height="30">
						<isee:navigation_item label="Model Dashboard"/>
						<isee:navigation_item label="Policies"/>
						<isee:navigation_item label="Model Assumptions"/>
					</isee:navigation_widget>
					<isee:shape background="#D8E2E3" border_color="#3C6E71" border_width="thick" transparent_background="false" x="21.579" y="91.5851" width="1016.84" height="447.685" kind="rectangle"/>
					<text_box font_weight="bold" text_align="center" vertical_text_align="center" font_color="#3D405B" font_size="24pt" appearance="transparent" x="475.593" y="549.307" width="76.4706" height="30.7988">2015</text_box>
					<text_box font_weight="bold" text_align="center" vertical_text_align="center" font_color="#3D405B" font_size="24pt" appearance="transparent" x="845.299" y="549.307" width="76.4706" height="30.7988">2037</text_box>
				</view>
			</isee:templates>
			<isee:stories/>
		</views>
	</model>
	<model name="SE3IR">
		<variables>
			<stock name="S">
				<doc>Susceptible individuals</doc>
				<eqn>(N - P0) *  par_iota_v</eqn>
				<inflow>Sq_to_S</inflow>
				<inflow>&quot;W!2_to_S&quot;</inflow>
				<outflow>S_to_E</outflow>
				<outflow>S_to_Sq</outflow>
				<outflow>S_to_E_i</outflow>
				<outflow>S_to_R</outflow>
				<outflow>S_to_Sv</outflow>
				<units>People</units>
			</stock>
			<stock name="E">
				<doc>Exposed (infected but no infectious)</doc>
				<eqn>0</eqn>
				<inflow>S_to_E</inflow>
				<inflow>Sv_to_E</inflow>
				<inflow>Sh_to_E</inflow>
				<outflow>E_to_P</outflow>
				<outflow>E_to_A</outflow>
				<outflow>E_to_Pd</outflow>
				<units>People</units>
			</stock>
			<stock name="P">
				<doc>Pre-clinical infectious individuals.</doc>
				<eqn>P0</eqn>
				<inflow>E_to_P</inflow>
				<outflow>P_to_I</outflow>
				<units>People</units>
			</stock>
			<stock name="I">
				<doc>Clinical infectious individuals</doc>
				<eqn>0</eqn>
				<inflow>P_to_I</inflow>
				<outflow>I_to_R</outflow>
				<units>People</units>
			</stock>
			<stock name="R">
				<doc>Recovered (immune) individuals</doc>
				<eqn>0</eqn>
				<inflow>I_to_R</inflow>
				<inflow>A_to_R</inflow>
				<inflow>Id_to_R</inflow>
				<inflow>S_to_R</inflow>
				<inflow>Aq_to_R</inflow>
				<inflow>Iq_to_R</inflow>
				<outflow>R_to_W1</outflow>
				<units>People</units>
			</stock>
			<flow name="S to E">
				<eqn>S * lambda</eqn>
				<units>people/day</units>
			</flow>
			<flow name="E to P">
				<eqn>(1- var_theta) * par_omega * par_sigma* E</eqn>
				<units>people/day</units>
			</flow>
			<flow name="P to I">
				<eqn>par_nu * P</eqn>
				<units>people/day</units>
			</flow>
			<flow name="I to R">
				<eqn>par_gamma * I</eqn>
				<units>people/day</units>
			</flow>
			<stock name="A">
				<doc>Sub-clinical infectious individuals</doc>
				<eqn>0</eqn>
				<inflow>E_to_A</inflow>
				<outflow>A_to_R</outflow>
				<units>People</units>
			</stock>
			<flow name="E to A">
				<eqn>(1 - par_omega) * par_sigma * E</eqn>
				<units>people/day</units>
			</flow>
			<flow name="A to R">
				<doc>Recovered (immune) individuals</doc>
				<eqn>par_kappa * A</eqn>
				<units>people/day</units>
			</flow>
			<aux name="par gamma">
				<doc>Rate at which clinical individuals recover.</doc>
				<eqn>0.5</eqn>
				<units>1/day</units>
			</aux>
			<aux name="N">
				<doc>Population size</doc>
				<eqn>1000000</eqn>
				<units>People</units>
			</aux>
			<aux name="par sigma">
				<doc>Rate at which the exposed class becomes infectious.</doc>
				<eqn>1/2</eqn>
				<units>1/day</units>
			</aux>
			<aux name="par omega">
				<doc>Clinical fraction.</doc>
				<eqn>0.84</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="P0">
				<doc>Initial number of pre-clinical infectious individuals.</doc>
				<eqn>1</eqn>
				<units>People</units>
			</aux>
			<aux name="par nu">
				<doc>Symptom onset rate.</doc>
				<eqn>1</eqn>
				<units>1/day</units>
			</aux>
			<aux name="par kappa">
				<doc>Rate at which sub-clinical individuals recover.</doc>
				<eqn>1/5</eqn>
				<units>1/day</units>
			</aux>
			<aux name="par eta">
				<doc>Relative infectiousness</doc>
				<eqn>0.5</eqn>
				<units>Dimensionless</units>
			</aux>
			<stock name="C">
				<doc>Cumulative cases</doc>
				<eqn>P0</eqn>
				<inflow>C_in</inflow>
				<units>People</units>
			</stock>
			<flow name="C in">
				<doc>Incidence rate</doc>
				<eqn>S_to_E + Sv_to_E + Sh_to_Ei + S_to_E_i +Sh_to_E</eqn>
				<units>people/day</units>
			</flow>
			<aux name="B">
				<doc>Effective contact rate</doc>
				<eqn>var_zeta_t * par_upsilon</eqn>
				<units>1/day</units>
			</aux>
			<stock name="Id">
				<doc>Diagnosed clinical infectious individuals.</doc>
				<eqn>0</eqn>
				<inflow>Pd_to_Id</inflow>
				<outflow>Id_to_R</outflow>
				<units>People</units>
			</stock>
			<flow name="Pd to Id">
				<eqn>par_nu * Pd</eqn>
				<units>people/day</units>
			</flow>
			<flow name="Id to R">
				<eqn>par_gamma * Id</eqn>
				<units>people/day</units>
			</flow>
			<stock name="Pd">
				<doc>Eventually diagnosed pre-clinical infectious individuals.</doc>
				<eqn>0</eqn>
				<inflow>E_to_Pd</inflow>
				<outflow>Pd_to_Id</outflow>
				<units>People</units>
			</stock>
			<flow name="E to Pd">
				<eqn>var_theta * par_omega * par_sigma * E</eqn>
				<units>people/day</units>
			</flow>
			<aux name="var theta">
				<doc>Time-varying testing fraction.</doc>
				<eqn>IF Dd = 0 
THEN 0  
ELSE MIN(par_delta * Dd, testing_supply)/Dd</eqn>
				<units>Dimensionless</units>
			</aux>
			<flow name="Change Qd">
				<doc>Adjust testing capacity</doc>
				<eqn>par_rho_d * Qd * (1 - (Qd/par_alpha_d))</eqn>
				<units>people/day/Days</units>
			</flow>
			<aux name="par alpha d">
				<doc>Maximum testing capacity per 1000 population</doc>
				<eqn>100</eqn>
				<units>people/day</units>
			</aux>
			<aux name="par rho d">
				<doc>Growth of available testing capacity.</doc>
				<eqn>0.15</eqn>
				<units>1/day</units>
			</aux>
			<stock name="Qd">
				<doc>Available testing capacity.</doc>
				<eqn>100</eqn>
				<inflow>Change_Qd</inflow>
				<units>people/day</units>
			</stock>
			<aux name="testing supply">
				<doc>Number of tested people given supply &amp; demand.</doc>
				<eqn>Qd * N / scaler*testing</eqn>
				<units>people/day</units>
			</aux>
			<aux name="Dd">
				<doc>Potential testing demand. It&apos;s potential because not every individual who develops symptoms seeks a diagnostic test.</doc>
				<eqn>par_omega * par_sigma *E</eqn>
				<units>People/day</units>
			</aux>
			<stock name="Sq">
				<doc>Susceptible individuals in quarantine.</doc>
				<eqn>0</eqn>
				<inflow>S_to_Sq</inflow>
				<outflow>Sq_to_S</outflow>
				<units>People</units>
			</stock>
			<flow name="Sq to S">
				<eqn>Sq / (1 / par_sigma + 1 / par_gamma + 1 / par_nu)</eqn>
				<units>people/day</units>
			</flow>
			<flow name="S to Sq">
				<eqn>var_mu_s * S</eqn>
				<units>People/day</units>
			</flow>
			<flow name="S to E i">
				<eqn>var_mu_i * S</eqn>
				<units>People/day</units>
			</flow>
			<stock name="Eq">
				<doc>Exposed (infected but no infectious) individuals in quarantine</doc>
				<eqn>0</eqn>
				<inflow>S_to_E_i</inflow>
				<inflow>Sh_to_Ei</inflow>
				<outflow>Eq_to_Iq</outflow>
				<outflow>Eq_to_Aq</outflow>
				<units>People</units>
			</stock>
			<flow name="Eq to Iq">
				<eqn>par_omega * par_sigma * Eq</eqn>
				<units>people/day</units>
			</flow>
			<aux name="var zeta t">
				<doc>Time-varying contact rate. That is, the number of daily contacts per person.</doc>
				<eqn>par_zeta_0 * Z</eqn>
				<units>1/day</units>
			</aux>
			<aux name="par upsilon">
				<doc>Probability of infection.</doc>
				<eqn>0.1</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="lambda Pd">
				<eqn>par_upsilon * (var_zeta_t - var_zeta_k) * Pd / N</eqn>
				<units>1/day</units>
			</aux>
			<aux name="lambda P">
				<eqn>B * P / N</eqn>
				<units>1/day</units>
			</aux>
			<aux name="lambda Id">
				<eqn>(1 - par_iota_d) * B * Id / N</eqn>
				<units>1/day</units>
			</aux>
			<aux name="lambda I">
				<eqn>B * I / N</eqn>
				<units>1/day</units>
			</aux>
			<aux name="lambda Iq">
				<eqn> (1 - par_iota_d) * B  * Iq /N</eqn>
				<units>1/day</units>
			</aux>
			<aux name="par iota d">
				<doc>Willingness to isolate.</doc>
				<eqn>0.52</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="lambda A">
				<eqn>par_eta * B * A /N</eqn>
				<units>1/day</units>
			</aux>
			<aux name="tau Z">
				<doc>Time to achieve the desired mobility.</doc>
				<eqn>20</eqn>
				<units>Days</units>
			</aux>
			<stock name="Z">
				<doc>Relative mobility with respect to the value in peace time</doc>
				<eqn>1</eqn>
				<inflow>Adjust_Z</inflow>
				<units>Dimensionless</units>
			</stock>
			<flow name="Adjust Z">
				<doc>Changes in mobility</doc>
				<eqn>(Z_star - Z) / tau_Z</eqn>
				<units>1/day</units>
			</flow>
			<stock name="Qm">
				<doc>Budget for mobility restrictions</doc>
				<eqn>60</eqn>
				<outflow>Decrease_Qm</outflow>
				<units>Dimensionless</units>
			</stock>
			<flow name="Decrease Qm">
				<eqn>uc * Qm_supply</eqn>
				<units>1/day</units>
			</flow>
			<aux name="Qm supply">
				<doc>Mobility restrictions constrained by available budget</doc>
				<eqn>IF TIME &gt;= par_tau_m
THEN   MIN(par_xi,  Qm)*mobility_reduction
ELSE 0</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="Z star">
				<doc>Desired mobility that policymakers aim to achieve</doc>
				<eqn> 1 - Qm_supply</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="par tau m">
				<doc>Time at which the mobility restrictions start</doc>
				<eqn>30</eqn>
				<units>Days</units>
			</aux>
			<aux name="uc">
				<doc>Unit converter. </doc>
				<eqn>1</eqn>
				<units>1/day</units>
			</aux>
			<flow name="S to R">
				<doc>Effective vaccination rate.</doc>
				<eqn>par_phi * var_psi * S</eqn>
				<units>people/day</units>
			</flow>
			<aux name="par iota v">
				<doc>Fraction of individuals who are willing to get a vaccine. Affects stocks S &amp; Sh.</doc>
				<eqn>0.72</eqn>
				<units>Dimensionless</units>
			</aux>
			<stock name="Sv">
				<doc>Individuals who remain susceptible after vaccination.</doc>
				<eqn>0</eqn>
				<inflow>S_to_Sv</inflow>
				<outflow>Sv_to_E</outflow>
				<units>People</units>
			</stock>
			<flow name="Sv to E">
				<eqn>lambda * Sv</eqn>
				<units>people/day</units>
			</flow>
			<flow name="S to Sv">
				<eqn>(1 - par_phi) * var_psi * S</eqn>
				<units>people/day</units>
			</flow>
			<aux name="var psi">
				<doc>Time-varying vaccination fraction.</doc>
				<eqn>MIN(Vaccine_demand,  Vaccine_supply) / S</eqn>
				<units>1/day</units>
			</aux>
			<aux name="par phi">
				<doc>Vaccine effectiveness</doc>
				<eqn>0.65</eqn>
				<units>Dimensionless</units>
			</aux>
			<stock name="Qv">
				<doc>Available vaccination capacity.</doc>
				<eqn>2.45</eqn>
				<inflow>Change_Qv</inflow>
				<units>people/day</units>
			</stock>
			<flow name="Change Qv">
				<eqn>IF TIME &gt;= par_tau_v 
THEN par_rho_v * Qv * (1 - (Qv/par_alpha_v)) 
ELSE 0</eqn>
				<units>people/day/Days</units>
			</flow>
			<aux name="par rho v">
				<doc>Growth of available vaccination capacity.</doc>
				<eqn>0.15</eqn>
				<units>1/day</units>
			</aux>
			<aux name="par alpha v">
				<doc>Maximum vaccination capacity per 1000 population</doc>
				<eqn>12.26</eqn>
				<units>people/day</units>
			</aux>
			<aux name="par tau v">
				<doc>Time at which vaccines become available.</doc>
				<eqn>30</eqn>
				<units>Days</units>
			</aux>
			<aux name="Vaccine supply">
				<doc>Auxiliary function to make vaccination available at a given date.</doc>
				<eqn>IF TIME &gt;= par_tau_v 
THEN Qv * N / scaler *vaccination
ELSE 0</eqn>
				<units>people/day</units>
			</aux>
			<aux name="par zeta 0">
				<doc>Number of daily contacts per person in the absence of mobility interventions.</doc>
				<eqn>9</eqn>
				<units>1/day</units>
			</aux>
			<aux name="scaler">
				<eqn>1000</eqn>
				<units>People</units>
			</aux>
			<aux name="par delta">
				<doc>Percentage of clinical individuals seeking a diagnostic test

Source: https://coronadashboard.government.nl/landelijk/gedrag</doc>
				<eqn>0.45</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="Vaccine demand">
				<doc>Vaccine demand.</doc>
				<eqn>uc * S</eqn>
				<units>people/day</units>
			</aux>
			<aux name="lambda">
				<doc>Force of infection</doc>
				<eqn>lambda_A + lambda_Aq + lambda_I + lambda_Id + lambda_Iq + lambda_P + lambda_Pd + lambda_Pq</eqn>
				<isee:summing/>
				<units>1/day</units>
			</aux>
			<stock name="Sh">
				<doc>Susceptible individuals who are hesitant to vaccination.</doc>
				<eqn>(N - P0) * (1 -  par_iota_v)</eqn>
				<inflow>Shq_to_Sh</inflow>
				<outflow>Sh_to_Ei</outflow>
				<outflow>Sh_to_E</outflow>
				<outflow>Sh_to_Shq</outflow>
				<units>People</units>
			</stock>
			<flow name="Sh to Ei">
				<doc>Hesitant susceptible individuals put into quarantine</doc>
				<eqn>var_mu_i * Sh</eqn>
				<units>people/day</units>
			</flow>
			<flow name="Sh to E">
				<doc>Hesitant susceptibles who get infected</doc>
				<eqn>Sh *lambda</eqn>
				<units>people/day</units>
			</flow>
			<stock name="Shq">
				<doc>Susceptible individuals who are hesitant to vaccines in quarantine.</doc>
				<eqn>0</eqn>
				<inflow>Sh_to_Shq</inflow>
				<outflow>Shq_to_Sh</outflow>
				<units>People</units>
			</stock>
			<flow name="Sh to Shq">
				<eqn>var_mu_s * Sh</eqn>
				<units>people/day</units>
			</flow>
			<flow name="Shq to Sh">
				<eqn>Shq / (1 / par_sigma + 1 / par_gamma + 1 / par_nu)</eqn>
				<units>people/day</units>
			</flow>
			<stock name="Pq">
				<doc>Pre-clinical infectious individuals in quarantine</doc>
				<eqn>0</eqn>
				<inflow>Eq_to_Iq</inflow>
				<outflow>Pq_to_Iq</outflow>
				<units>People</units>
			</stock>
			<flow name="Iq to R">
				<eqn>par_gamma * Iq</eqn>
				<units>people/day</units>
			</flow>
			<flow name="Eq to Aq">
				<eqn>(1 - par_omega) * par_sigma * Eq</eqn>
				<units>people/day</units>
			</flow>
			<stock name="Aq">
				<doc>Sub-clinical infectious individuals in quarantine</doc>
				<eqn>0</eqn>
				<inflow>Eq_to_Aq</inflow>
				<outflow>Aq_to_R</outflow>
				<units>People</units>
			</stock>
			<stock name="Iq">
				<doc>Clinical infectious individuals in quarantine</doc>
				<eqn>0</eqn>
				<inflow>Pq_to_Iq</inflow>
				<outflow>Iq_to_R</outflow>
				<units>People</units>
			</stock>
			<flow name="Aq to R">
				<eqn>par_kappa *Aq</eqn>
				<units>people/day</units>
			</flow>
			<flow name="Pq to Iq">
				<eqn>par_nu * Pq</eqn>
				<units>people/day</units>
			</flow>
			<aux name="var mu i">
				<doc>Per capita rate at which infections are contact traced.</doc>
				<eqn>par_upsilon * var_zeta_k * Pd  / N</eqn>
				<units>1/day</units>
			</aux>
			<stock name="Qk">
				<doc>Available tracing capacity.</doc>
				<eqn>0.05331</eqn>
				<inflow>Change_Qk</inflow>
				<units>people/day</units>
			</stock>
			<flow name="Change Qk">
				<doc>Adjust contact tracing capacity</doc>
				<eqn>par_rho_k * Qk * (1 - (Qk/par_alpha_k))</eqn>
				<units>people/day/Days</units>
			</flow>
			<aux name="par alpha k">
				<doc>Maximum tracing capacity per 1000 population</doc>
				<eqn>50</eqn>
				<units>people/day</units>
			</aux>
			<aux name="par rho k">
				<doc>Growth of available tracing capacity.</doc>
				<eqn>0.02594023 * 10</eqn>
				<units>1/day</units>
			</aux>
			<aux name="Dk">
				<doc>Contact tracing demand</doc>
				<eqn>var_zeta_t * Pd</eqn>
				<units>People/day</units>
			</aux>
			<aux name="k">
				<doc>Number of contact-traced people given supply &amp; demand.</doc>
				<eqn>MIN(Dk,  contact_tracing_supply)</eqn>
				<units>people/day</units>
			</aux>
			<aux name="contact tracing\nsupply">
				<doc>Contact tracing supply</doc>
				<eqn>Qk * N / scaler</eqn>
				<units>people/day</units>
			</aux>
			<aux name="var mu s">
				<doc>Per-capita rate at which non-infected susceptible individuals are contact traced.</doc>
				<eqn>(1 - par_upsilon) * var_zeta_k * Pd / N</eqn>
				<units>1/day</units>
			</aux>
			<aux name="var zeta k">
				<doc>Average number of contact-traced individuals.</doc>
				<eqn>IF Pd = 0
THEN 0
ELSE (k/Pd)*contact_tracing</eqn>
				<units>1/day</units>
			</aux>
			<aux name="lambda Aq">
				<eqn>(1 - par_iota_d) * B * par_eta * Aq / N</eqn>
				<units>1/day</units>
			</aux>
			<aux name="lambda Pq">
				<eqn>(1 - par_iota_d) * B * Pq / N</eqn>
				<units>1/day</units>
			</aux>
			<stock name="Rv">
				<doc>Recovered or immune due to vaccination.</doc>
				<eqn>0</eqn>
				<inflow>Rv_in</inflow>
				<units>People</units>
			</stock>
			<flow name="Rv in">
				<eqn>S_to_R</eqn>
				<units>people/day</units>
			</flow>
			<aux name="par xi">
				<eqn>0.5</eqn>
			</aux>
			<aux name="vaccination">
				<eqn>0</eqn>
			</aux>
			<aux name="testing">
				<eqn>0</eqn>
			</aux>
			<aux name="contact tracing">
				<eqn>0</eqn>
			</aux>
			<aux name="mobility reduction">
				<eqn>0</eqn>
			</aux>
			<stock name="D">
				<eqn>0</eqn>
				<inflow>D_in</inflow>
				<non_negative/>
			</stock>
			<flow name="D in">
				<eqn>C_in*cfr</eqn>
			</flow>
			<aux name="cfr">
				<eqn>0.05</eqn>
			</aux>
			<flow name="AR in">
				<eqn>C_in/N</eqn>
			</flow>
			<stock name="Attack Rate">
				<eqn>0</eqn>
				<inflow>AR_in</inflow>
			</stock>
			<aux name="T">
				<eqn>TIME</eqn>
				<event_poster>
					<threshold direction="increasing" value="150" repeat="once">
						<event isee:kind="model_only">
							<text_box/>
						</event>
					</threshold>
				</event_poster>
			</aux>
			<stock name="W1">
				<eqn>0</eqn>
				<inflow>R_to_W1</inflow>
				<outflow>W1_to_W2</outflow>
				<non_negative/>
				<units>People</units>
			</stock>
			<flow name="R to W1">
				<eqn>IF TIME &gt; par_tau_w THEN R/(delay_duration/3)*new_variant ELSE 0</eqn>
				<non_negative/>
				<units>people/day</units>
			</flow>
			<flow name="W1 to W2">
				<eqn>W1/(delay_duration/3)</eqn>
				<non_negative/>
				<units>people/day</units>
			</flow>
			<aux name="delay duration">
				<eqn>25</eqn>
				<units>people/day</units>
			</aux>
			<aux name="par tau w">
				<eqn>100</eqn>
			</aux>
			<aux name="new variant">
				<eqn>0</eqn>
			</aux>
			<stock name="W2">
				<eqn>100</eqn>
				<inflow>W1_to_W2</inflow>
				<outflow>&quot;W!2_to_S&quot;</outflow>
				<non_negative/>
				<units>People</units>
			</stock>
			<flow name="W!2 to S">
				<eqn>W2/(delay_duration/3)</eqn>
				<non_negative/>
				<units>people/day</units>
			</flow>
		</variables>
